models/
checkpoints/
model_*/
*.bin
*.pt
*.pth
*.safetensors
*.onnx

# Uploads / runtime transcript data
src/web/uploads/*
!src/web/uploads/.gitkeep
src/web/data/transcripts/*
!src/web/data/transcripts/.gitkeep
data/input/*
!data/input/.gitkeep
data/output/*
