# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
venv_gpu/
env/

# Environment files and secrets (NEVER commit API keys)
.env
.env.*
!.env.example
*.env

# Archives & large binaries
*.rar
*.zip
*.tar.gz
*.7z

# Logs and results
*.log
results.txt
results_clean.txt

