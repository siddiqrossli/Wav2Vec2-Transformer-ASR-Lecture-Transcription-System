# Optional AI features (does not affect Wav2Vec2 ASR — only used after transcription)

# --- Google Gemini (Recommended) ---
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash

# --- OpenAI ---
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local) ---
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# --- Groq / other OpenAI-compatible providers ---
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.1-8b-instant

# Max characters of transcript sent to the LLM (long lectures are trimmed)
# LLM_MAX_TRANSCRIPT_CHARS=14000

# Saved transcripts for Library / RAG live in src/web/data/transcripts/
# (automatic; does not affect Wav2Vec2 model files)
